{
  "name": "quick-launch",
  "version": "1.0.0",
  "description": "应用程序启动管理器 - 管理并启动指定文件夹下的可执行程序",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --win --x64"
  },
  "author": "huangthreeox",
  "license": "MIT",
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.quicklaunch.app",
    "productName": "QuickLaunch",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "huangthreeox",
      "repo": "hb_quicklauch"
    }
  }
}
